{# Full state template. Revised 2026-08-01.
   The planner distinguishes a no-discharge hold from intentional charging. #}
{% set plan = states('sensor.hems_powerwall_grid_charge_plan') %}

{% if plan in [
  'HOLD_FOR_CHEAPER_GRID',
  'HOLD_FORECAST_UNAVAILABLE',
  'TARGET_AT_RISK_PRICE_TOO_HIGH',
  'CHARGE_CHEAPEST_VISIBLE',
  'CHARGE_LATEST_SAFE_START'
] %}
  backup

{% elif plan in [
  'MIDNIGHT_ROLLOVER_GUARD',
  'TARGET_MET',
  'NO_DAILY_SHORTFALL',
  'DEADLINE_PASSED_WITH_SHORTFALL'
] %}
  self_consumption

{% else %}
  hold
{% endif %}
