{% set capacity_kwh = 60.4 %}
{% set availability = states('sensor.ev_charging_availability') %}
{% set soc_raw = states('sensor.hems_effective_ev_soc') %}
{% set target_raw = states('sensor.hems_ev_target_today') %}
{% set cheap_minutes_raw = states('sensor.hems_cheap_grid_minutes_before_target') %}
{% set ev_rate_raw = states('input_number.hems_ev_planning_charge_power') %}
{% set target_time_raw = states('input_datetime.hems_charging_target_time') %}
{% set target_time = target_time_raw
    if target_time_raw not in ['unknown', 'unavailable', 'none', '']
    else '14:30:00' %}
{% set deadline = today_at(target_time) %}

{% set inputs_valid = is_number(soc_raw)
    and is_number(target_raw)
    and is_number(cheap_minutes_raw)
    and is_number(ev_rate_raw) %}

{% if not inputs_valid %}
  unknown
{% else %}
  {% set soc = soc_raw | float %}
  {% set target = target_raw | float %}
  {% set cheap_minutes = [cheap_minutes_raw | float, 0] | max %}
  {% set ev_rate = ev_rate_raw | float %}
  {% set remaining_to_target = ([((target - soc) / 100) * capacity_kwh, 0] | max) %}

  {% if soc >= target
        or availability not in ['READY', 'CHARGING']
        or now() >= deadline
        or ev_rate <= 0 %}
    {{ soc | round(0) }}
  {% else %}
    {% set total_minutes = ([
        (as_timestamp(deadline) - as_timestamp(now())) / 60,
        0
      ] | max) %}

    {% set forced_recovery = (soc <= 30)
        or (is_state('input_boolean.hems_ev_urgent_charge_active', 'on') and soc < 50)
        or (is_state('input_boolean.hems_ev_recovery_approved', 'on') and soc < 50) %}
    {% set forced_target = [50, target] | min %}
    {% set forced_required = ([
        ((forced_target - soc) / 100) * capacity_kwh,
        0
      ] | max) if forced_recovery else 0 %}
    {% set forced_minutes_needed = (forced_required / ev_rate) * 60 %}
    {% set forced_minutes = [forced_minutes_needed, total_minutes] | min %}
    {% set forced_energy = [
        (forced_minutes / 60) * ev_rate,
        forced_required
      ] | min %}

    {# Conservatively assume mandatory charging consumes cheap intervals first. #}
    {% set cheap_minutes_after_forced = [cheap_minutes - forced_minutes, 0] | max %}

    {% set energy_after_forced = [remaining_to_target - forced_energy, 0] | max %}
    {% set cheap_energy = [
        (cheap_minutes_after_forced / 60) * ev_rate,
        energy_after_forced
      ] | min %}
    {% set planned_energy = [forced_energy + cheap_energy, remaining_to_target] | min %}
    {% set projected_soc = [soc + ((planned_energy / capacity_kwh) * 100), target] | min %}

    {{ projected_soc | round(0) }}
  {% endif %}
{% endif %}
