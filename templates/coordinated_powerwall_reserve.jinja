{# Full state template. Revised 2026-07-31.
   Teslemetry did not retain a 99% reserve during live commissioning, so only
   that unstable request is normalised to the supported 100% endpoint. #}
{% set coordinated_mode = states('sensor.hems_coordinated_powerwall_mode') %}
{% set interlock = states('sensor.hems_ev_powerwall_interlock_request') %}
{% set hold_raw = states('sensor.hems_ev_powerwall_hold_reserve') %}
{% set target_raw = states('input_number.powerwall_target') %}
{% set minimum_raw = states('input_number.minimum_power_reserve') %}
{% set actual_soc_raw = states(
  'sensor.house_home_energy_gateway_teslemetry_percentage_charged'
) %}
{% set request_entity = states.sensor.hems_ev_powerwall_interlock_request %}
{% if request_entity is not none %}
  {% set request_age_seconds = [
      as_timestamp(now()) - as_timestamp(request_entity.last_changed),
      0
    ] | max %}
{% else %}
  {% set request_age_seconds = 99999 %}
{% endif %}

{% if not is_number(minimum_raw) %}
  unknown

{% elif interlock == 'REQUEST_EARLY_FLEXIBLE_DISCHARGE' %}
  {% set requested = minimum_raw | float %}
  {% set bounded = [[requested, 0] | max, 100] | min %}
  {{ 100 if (bounded | round(0) | int) == 99 else (bounded | round(0)) }}

{% elif interlock == 'REQUEST_APPROVED_HOLD_ONLY' %}
  {# On the transition into hold, use the live real SOC immediately. The
     companion latch stores the same value for the steady-state hold. #}
  {% if request_age_seconds <= 15 and is_number(actual_soc_raw) %}
    {% set requested = [actual_soc_raw | float, minimum_raw | float] | max %}
    {% set bounded = [[requested, 0] | max, 100] | min %}
    {{ 100 if (bounded | round(0) | int) == 99 else (bounded | round(0)) }}
  {% elif not is_number(hold_raw) %}
    unknown
  {% else %}
    {% set requested = [hold_raw | float, minimum_raw | float] | max %}
    {% set bounded = [[requested, 0] | max, 100] | min %}
    {{ 100 if (bounded | round(0) | int) == 99 else (bounded | round(0)) }}
  {% endif %}

{% elif interlock in [
  'REQUEST_CHEAP_GRID_CHARGE_AND_HOLD',
  'REQUEST_CHEAP_GRID_HOLD_ONLY',
  'REQUEST_URGENT_HOLD_ONLY'
] %}
  {% if not is_number(hold_raw) %}
    unknown
  {% else %}
    {% set requested = [hold_raw | float, minimum_raw | float] | max %}
    {% set bounded = [[requested, 0] | max, 100] | min %}
    {{ 100 if (bounded | round(0) | int) == 99 else (bounded | round(0)) }}
  {% endif %}

{% elif interlock == 'NO_REQUEST' and coordinated_mode == 'backup' %}
  {% if not is_number(target_raw) %}
    unknown
  {% else %}
    {% set requested = target_raw | float %}
    {% set bounded = [[requested, 0] | max, 100] | min %}
    {{ 100 if (bounded | round(0) | int) == 99 else (bounded | round(0)) }}
  {% endif %}

{% elif interlock == 'NO_REQUEST'
      and coordinated_mode == 'self_consumption' %}
  {% set requested = minimum_raw | float %}
  {% set bounded = [[requested, 0] | max, 100] | min %}
  {{ 100 if (bounded | round(0) | int) == 99 else (bounded | round(0)) }}

{% else %}
  unknown
{% endif %}
