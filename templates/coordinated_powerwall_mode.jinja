{% set brain_mode = states('sensor.hems_expected_powerwall_mode') %}
{% set interlock = states('sensor.hems_ev_powerwall_interlock_request') %}
{% set cycle_phase = states(
  'input_select.hems_solar_powerwall_soc_cycle_phase'
) %}
{% set cycle_live = is_state(
  'input_boolean.hems_solar_powerwall_soc_cycle_live_control_enabled', 'on'
) and cycle_phase in ['DISCHARGE', 'RECOVERY'] %}

{% if interlock in [
  'REQUEST_CHEAP_GRID_CHARGE_AND_HOLD',
  'REQUEST_CHEAP_GRID_HOLD_ONLY',
  'REQUEST_URGENT_HOLD_ONLY',
  'REQUEST_APPROVED_HOLD_ONLY',
  'REQUEST_NATIVE_EXCESS_HOLD_100'
] %}
  backup

{% elif interlock == 'REQUEST_EARLY_FLEXIBLE_DISCHARGE' %}
  self_consumption

{% elif cycle_live and interlock == 'NO_REQUEST' %}
  self_consumption

{% elif interlock == 'NO_REQUEST'
      and brain_mode in ['backup', 'self_consumption'] %}
  {{ brain_mode }}

{% elif interlock in [
  'INPUT_UNAVAILABLE',
  'SESSION_STATE_CONFLICT',
  'INVALID_SESSION_TYPE',
  'unknown',
  'unavailable',
  ''
] %}
  INTERLOCK_UNAVAILABLE

{% else %}
  BRAIN_MODE_UNAVAILABLE
{% endif %}
